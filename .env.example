# =============================================================================
# CloudCarbon — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL 15)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cloudcarbon
DATABASE_POOL_SIZE=10

# Docker Compose overrides (used by docker-compose.yml)
POSTGRES_USER=cloudcarbon
POSTGRES_PASSWORD=cloudcarbon
POSTGRES_DB=cloudcarbon

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Active Directory
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Okta
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=

# -----------------------------------------------------------------------------
# Cloud Provider Credentials
# (Per connected account — stored in vault, not here)
# These are used only for the ingestion service account.
# -----------------------------------------------------------------------------

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# GCP
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=

# Alibaba Cloud
ALIBABA_ACCESS_KEY_ID=
ALIBABA_ACCESS_KEY_SECRET=

# -----------------------------------------------------------------------------
# External Data APIs
# -----------------------------------------------------------------------------

# Electricity Maps — real-time carbon intensity data
ELECTRICITY_MAPS_API_KEY=

# WRI Aqueduct — water stress data
WRI_AQUEDUCT_API_KEY=

# Boavizta — hardware embodied carbon data
BOAVIZTA_API_URL=https://api.boavizta.org

# -----------------------------------------------------------------------------
# Anthropic (AI features)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
