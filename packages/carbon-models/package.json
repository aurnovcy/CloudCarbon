{
  "name": "@cloudcarbon/carbon-models",
  "version": "0.1.0",
  "private": true,
  "description": "Carbon and water estimation logic (TypeScript + Python)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@cloudcarbon/focus-schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
